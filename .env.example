# Postgres connection strings.
# Local Docker defaults are in .env.local.example.
DATABASE_URL=postgresql://user:password@host:6543/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Set to true if the host requires SSL and the URL has no sslmode parameter.
# DATABASE_SSL=true

# OpenRouter key for the Grounds to Glow kiosk chat
OPENROUTER_API_KEY=

# Hugging Face Space that reads the scale display on the cleaner weigh step
HF_SPACE_ID=kevansoon/PaddleOCR
# Only needed if the Space is private
# HF_TOKEN=hf_xxx

# Upstash Redis snapshot cache (optional). Create a free database at upstash.com,
# or provision through Vercel Marketplace. Leave unset to read Postgres directly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
