# Local Docker Postgres 18
DATABASE_URL=postgres://smu:smu@localhost:55432/smu_coffee
DIRECT_URL=postgres://smu:smu@localhost:55432/smu_coffee

# Shows Reset, Sync, Simulate and the weigh screen's demo states. Leave unset on shared deployments.
# NEXT_PUBLIC_DEMO_CONTROLS=true

# Upstash Redis snapshot cache (optional). Free tier works locally; leave unset to read Postgres directly.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
