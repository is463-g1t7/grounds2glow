        <mxCell id="note" value="SMU Circular Coffee prototype. External systems are third-party services the prototype calls at runtime." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="760" height="36" as="geometry" /></mxCell>
        <mxCell id="cleaner" value="&lt;b&gt;Cleaner / pantry staff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;br&gt;Scans a staff pass and weighs each drop-off&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;align=center;verticalAlign=middle;spacingTop=30;width=150;height=170;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="150" height="170" as="geometry" /></mxCell>
        <mxCell id="ops" value="&lt;b&gt;OCIS &amp; facilities staff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;br&gt;Watches the live dashboard and collects full bins&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;align=center;verticalAlign=middle;spacingTop=30;width=150;height=170;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="150" height="170" as="geometry" /></mxCell>
