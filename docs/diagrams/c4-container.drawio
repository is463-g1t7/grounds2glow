<mxfile host="app.diagrams.net" type="device">
  <diagram id="c4-container" name="c4-container">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="C4 Level 2 — Containers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#141B4D;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="520" height="40" as="geometry" /></mxCell>
        <mxCell id="note" value="One Next.js deployment on Vercel, one Postgres database, and two external API services. Locally the same app runs with Docker Postgres." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="900" height="36" as="geometry" /></mxCell>
        <mxCell id="cleaner" value="&lt;b&gt;Cleaner / pantry staff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;br&gt;Uses a phone or station laptop&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;align=center;verticalAlign=middle;spacingTop=30;width=150;height=170;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="150" height="170" as="geometry" /></mxCell>
        <mxCell id="ops" value="&lt;b&gt;OCIS &amp; facilities staff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;br&gt;Watches the live dashboard&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;align=center;verticalAlign=middle;spacingTop=30;width=150;height=170;" vertex="1" parent="1"><mxGeometry x="50" y="380" width="150" height="170" as="geometry" /></mxCell>
        <mxCell id="student" value="&lt;b&gt;SMU student / staff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Person]&lt;br&gt;Uses the kiosk and chat&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#08427B;align=center;verticalAlign=middle;spacingTop=30;width=150;height=170;" vertex="1" parent="1"><mxGeometry x="50" y="610" width="150" height="170" as="geometry" /></mxCell>
        <mxCell id="boundary" value="SMU Circular Coffee" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="820" height="700" as="geometry" /></mxCell>
        <mxCell id="web" value="&lt;b&gt;Web client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: React 19]&lt;br&gt;Landing, dashboard, cleaner station and kiosk. Camera, barcode and QR generation.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="320" y="210" width="300" height="170" as="geometry" /></mxCell>
        <mxCell id="server" value="&lt;b&gt;Next.js server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: Next.js 16]&lt;br&gt;App Router pages, route handlers, server-side domain logic and Drizzle access.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="720" y="200" width="330" height="190" as="geometry" /></mxCell>
        <mxCell id="postgres" value="&lt;b&gt;Postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Container: PostgreSQL 18]&lt;br&gt;Supabase in production; Docker locally. Bins, events, cleaners and programme data.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#438DD5;align=center;verticalAlign=top;size=10;" vertex="1" parent="1"><mxGeometry x="320" y="540" width="280" height="140" as="geometry" /></mxCell>
        <mxCell id="hf" value="&lt;b&gt;Hugging Face OCR Space&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;br&gt;PaddleOCR on a Gradio Space&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#999999;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="660" y="880" width="260" height="130" as="geometry" /></mxCell>
        <mxCell id="openrouter" value="&lt;b&gt;OpenRouter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[External System]&lt;br&gt;z-ai/glm-5.3-flash&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#999999;fontColor=#FFFFFF;strokeColor=#999999;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1130" y="320" width="230" height="130" as="geometry" /></mxCell>
        <mxCell id="e1" value="Uses over HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.4;" edge="1" parent="1" source="cleaner" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e1b" value="Watches dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="ops" target="web"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="465" /><mxPoint x="250" y="329" /></Array></mxGeometry></mxCell>
        <mxCell id="e1c" value="Uses kiosk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.9;" edge="1" parent="1" source="student" target="web"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="695" /><mxPoint x="280" y="363" /></Array></mxGeometry></mxCell>
        <mxCell id="e2" value="fetch /api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="web" target="server"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e3" value="SQL via Drizzle (pooled)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="server" target="postgres"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="786" y="470" /><mxPoint x="460" y="470" /></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="Gradio client" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="server" target="hf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="800" /><mxPoint x="790" y="800" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#707070;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="server" target="openrouter"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
